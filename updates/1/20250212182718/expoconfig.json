{
  "expo": {
    "name": "Flexit",
    "slug": "Flexit-Mobile",
    "privacy": "public",
    "platforms": ["ios", "android"],
    "version": "2.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png"
    },
    "updates": {
      "url": "https://expo-update-flexit.vercel.app/api/manifest",
      "runtimeVersion": "1.0.0",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": ["*/"],
    "notification": {
      "icon": "./assets/icon.png"
    },
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.flexit.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "148",
      "userInterfaceStyle": "automatic",
      "supportsTablet": false,
      "splash": {
        "userInterfaceStyle": "automatic"
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Flexit necesita usar la Camara para subir documentos para su registro.",
        "NSMicrophoneUsageDescription": "Flexit necesita usar el Microfono para usar la camara",
        "NSPhotoLibraryUsageDescription": "Flexit necesita usar la librería para subir documentos para su registro.",
        "NSPhotoLibraryAddUsageDescription": "Flexit necesita usar la librería para subir documentos para su registro.",
        "NSLocationWhenInUseUsageDescription": false,
        "NSCalendarsUsageDescription": false,
        "NSContactsUsageDescription": false,
        "NSMotionUsageDescription": false,
        "NSRemindersUsageDescription": false,
        "NSAppTransportSecurity": {
          "NSExceptionDomains": {
            "something.com": {
              "NSTemporaryExceptionAllowsInsecureHTTPLoads": false
            }
          }
        }
      }
    },
    "android": {
      "package": "com.flexit.app",
      "versionCode": 148,
      "userInterfaceStyle": "automatic",
      "allowBackup": false,
      "splash": {
        "userInterfaceStyle": "automatic"
      },
      "useNextNotificationsApi": true,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "NOTIFICATIONS",
        "CAMERA",
        "CAMERA_ROLL",
        "MEDIA_LIBRARY",
        "READ_INTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-av",
        {
          "microphonePermission": "Flexit necesita usar el Microfono para usar la camara."
        }
      ],
      [
        "expo-document-picker",
        {
          "appleTeamId": "2F4PT43ZHJ",
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Flexit necesita acceder a tu galeria para subir documentos para su registro."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Flexit necesita usar la librería para subir documentos para su registro.",
          "savePhotosPermission": "Flexit necesita usar la librería para subir documentos para su registro.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#ffffff"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "b96505bd-6d9b-4019-b6a8-2227ff2f722a"
      }
    }
  }
}
